# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts



# Cursor personal configuration
.cursor/

# Project documentation not tracked in Git
docs/
DATABASE_SCHEMA (2).md
PROJECT_DOCUMENTATION (3).md
SYSTEM_ARCHITECTURE (1).md

# Local development logs
*.log

# Runtime uploads that should not be pushed
/public/uploads/ids/
/public/uploads/payments/